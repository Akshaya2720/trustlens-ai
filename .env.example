# ==========================================
# TRUSTLENS AI — CONFIGURATION TEMPLATE
# Copy to .env and populate credentials
# ==========================================

# Application
APP_NAME=TrustLens AI Backend
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=

# Meta Model API (Mandatory)
# Docs: https://dev.meta.ai/docs/overview
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
META_VOICE_MODEL_ID=muse-voice-transcribe-1.0
META_TIMEOUT_SECONDS=60
META_MAX_RETRIES=3

# Threat Intelligence Providers
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# Database
# Production (PostgreSQL): postgresql+asyncpg://trustlens_user:trustlens_pass@localhost:5432/trustlens_db
# Local Development/Testing (SQLite): sqlite+aiosqlite:///./trustlens.db
DATABASE_URL=sqlite+aiosqlite:///./trustlens.db
DB_ECHO=false

# Cache / Queue (Optional)
REDIS_URL=

# Security Limits
MAX_UPLOAD_SIZE_BYTES=26214400
SAFE_URL_MAX_REDIRECTS=5
SAFE_URL_TIMEOUT_SECONDS=8
RETENTION_DAYS=30
REDACT_PII_IN_LOGS=true
